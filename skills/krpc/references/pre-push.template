#!/usr/bin/env bash
# pre-push — diff-scoped gates distilled from real review findings (template).
# Iron rule: every check cites a real incident/finding — no theoretical checks.
# Sink criteria: deterministic · pure git+grep · millisecond · diff-scoped
# (build-level checks belong in CI, not here). Checklist: docs/PR_SELF_CHECK.md.
#
# Install (once): git config core.hooksPath .githooks
# Baseline branch: git config hooks.baseline origin/<trunk>   (default origin/main)
# CI / manual re-run: pre-push --range origin/<trunk>..HEAD [remote_ref]
#   The hook is a reminder (bypassable via --no-verify); CI re-running the same
#   script is the actual gate.
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 1
BASELINE="$(git config --get hooks.baseline 2>/dev/null || echo origin/main)"
ZERO=0000000000000000000000000000000000000000
FAIL=0

# ---- checks ----
# One function per check. Header comment MUST state: source finding + negative
# probe recipe. Example shape (replace with real distilled checks):
# check_example() {
#   local range="$1" remote_ref="$2"
#   if git diff --name-only "$range" -- 'some/path/*' 2>/dev/null | grep -q .; then
#     printf 'pre-push: BLOCKED — <why + how to fix>\n' >&2
#     FAIL=1
#   fi
# }

check_range() {
  local range="$1" remote_ref="${2:-}"
  # call each check here:
  # check_example "$range" "$remote_ref"
  :
}

# ---- driver: hook mode (ranges on stdin) or --range mode (CI / manual) ----
if [ "${1:-}" = "--range" ] && [ -n "${2:-}" ]; then
  check_range "$2" "${3:-}"
else
  while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$remote_sha" = "$ZERO" ]; then
      base=$(git merge-base "$BASELINE" "$local_sha" 2>/dev/null || true)
      [ -n "$base" ] || continue
      check_range "$base..$local_sha" "$remote_ref"
    else
      check_range "$remote_sha..$local_sha" "$remote_ref"
    fi
  done
fi

exit "$FAIL"
